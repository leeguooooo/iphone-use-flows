{
  "version": 1,
  "name": "Open Settings",
  "description": "Launch the Settings app by bundle id and wait until it is in the foreground.",
  "app": "com.apple.Preferences",
  "category": "system",
  "risk": "navigation",
  "steps": [
    {
      "kind": "launch_app",
      "bundle": "com.apple.Preferences",
      "after_ms": 300
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "kind": "Application"
          }
        ]
      },
      "timeout_ms": 5000,
      "poll_ms": 200
    }
  ],
  "verified_on": [
    {
      "device": "iPhone 17 Pro Max",
      "ios": "26",
      "date": "2026-09-05"
    }
  ]
}
