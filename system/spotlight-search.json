{
  "version": 1,
  "name": "Spotlight search",
  "description": "Return home, open Spotlight, type the query supplied for this run, and submit it. Spotlight opens the top hit (an app, contact, or web result), so read /agent/elements afterwards to see where you landed.",
  "app": "com.apple.springboard",
  "category": "system",
  "risk": "navigation",
  "tags": [
    "search"
  ],
  "inputs": {
    "query": {
      "type": "string",
      "description": "Spotlight search words for this run (an app name opens that app).",
      "required": true
    }
  },
  "steps": [
    {
      "kind": "shortcut",
      "name": "home",
      "after_ms": 300
    },
    {
      "kind": "shortcut",
      "name": "spotlight"
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "kind": "TextField"
          }
        ]
      },
      "timeout_ms": 3000,
      "poll_ms": 100
    },
    {
      "kind": "type",
      "input": "query",
      "clear": true,
      "after_ms": 400
    },
    {
      "kind": "key",
      "name": "return",
      "after_ms": 800
    }
  ],
  "verified_on": [
    {
      "device": "iPhone 17 Pro Max",
      "ios": "27.0",
      "date": "2026-09-05",
      "app_version": "27.0"
    }
  ]
}
