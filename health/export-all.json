{
  "version": 1,
  "name": "Export all Health data (request)",
  "description": "English UI. Launch Health, open the profile page from the Summary tab, scroll to the bottom, tap 'Export All Health Data', and press 'Export' on the system alert through the native alert route (the alert does not reliably appear in the element tree, so no wait_for gates it). The phone then packs a zip (~1 minute) and shows the share sheet; continue with health/save-export-to-files. Locators use Health's stable accessibility identifiers where they exist; only the Profile button and the alert button are label-based. Fails closed if a label is missing or ambiguous. Hardware-proven in zh-CN as health/export-all-zh-cn; the English labels still need a run.",
  "app": "com.apple.Health",
  "category": "health",
  "risk": "navigation",
  "locale": "en",
  "tags": [
    "export",
    "backup",
    "draft",
    "no-canary"
  ],
  "steps": [
    {
      "kind": "launch_app",
      "bundle": "com.apple.Health",
      "after_ms": 500
    },
    {
      "kind": "wait_for",
      "expect": {
        "application": "Health",
        "present": [
          {
            "identifier": "UIA.Health.Tab.Summary"
          }
        ]
      },
      "timeout_ms": 8000,
      "poll_ms": 250
    },
    {
      "kind": "tap_locator",
      "locator": {
        "identifier": "UIA.Health.Tab.Summary"
      },
      "after_ms": 500
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "kind": "Button",
            "label": "Profile"
          }
        ]
      },
      "timeout_ms": 5000,
      "poll_ms": 200
    },
    {
      "kind": "tap_locator",
      "locator": {
        "kind": "Button",
        "label": "Profile"
      },
      "after_ms": 800
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "identifier": "UIA.Health.ShowHealthDetails"
          }
        ]
      },
      "timeout_ms": 5000,
      "poll_ms": 200
    },
    {
      "kind": "scroll",
      "x": 0.5,
      "y": 0.6,
      "dx": 0,
      "dy": 80,
      "after_ms": 400
    },
    {
      "kind": "scroll",
      "x": 0.5,
      "y": 0.6,
      "dx": 0,
      "dy": 80,
      "after_ms": 400
    },
    {
      "kind": "scroll",
      "x": 0.5,
      "y": 0.6,
      "dx": 0,
      "dy": 80,
      "after_ms": 600
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "identifier": "UIA.Health.ExportAllHealthData"
          }
        ]
      },
      "timeout_ms": 4000,
      "poll_ms": 200
    },
    {
      "kind": "tap_locator",
      "locator": {
        "identifier": "UIA.Health.ExportAllHealthData"
      },
      "after_ms": 1000
    },
    {
      "kind": "pause",
      "ms": 1500
    },
    {
      "kind": "alert",
      "button": "Export",
      "after_ms": 1000
    }
  ]
}
