{
  "version": 1,
  "name": "Export all Health data (request)",
  "description": "English UI. Launch Health, open the profile page from the Summary tab, scroll to the bottom, and tap 'Export All Health Data' then the confirming 'Export'. The phone then packs a zip for ~1 minute and shows the share sheet; continue with health/save-export-to-files, or read /agent/elements to handle the share sheet yourself. Fails closed (no tap) if a label is missing or ambiguous.",
  "app": "com.apple.Health",
  "category": "health",
  "risk": "navigation",
  "locale": "en",
  "tags": ["export", "backup", "draft"],
  "steps": [
    { "kind": "launch_app", "bundle": "com.apple.Health", "after_ms": 500 },
    {
      "kind": "wait_for",
      "expect": { "application": "Health", "present": [ { "kind": "Button", "label": "Summary" } ] },
      "timeout_ms": 8000,
      "poll_ms": 250
    },
    { "kind": "tap_label", "label": "Summary", "after_ms": 400 },
    { "kind": "tap_locator", "locator": { "kind": "Button", "label": "Profile" }, "after_ms": 800 },
    {
      "kind": "wait_for",
      "expect": { "present": [ { "kind": "Button", "label": "Done" } ] },
      "timeout_ms": 5000,
      "poll_ms": 200
    },
    { "kind": "scroll", "x": 0.5, "y": 0.6, "dx": 0, "dy": 80, "after_ms": 400 },
    { "kind": "scroll", "x": 0.5, "y": 0.6, "dx": 0, "dy": 80, "after_ms": 400 },
    { "kind": "scroll", "x": 0.5, "y": 0.6, "dx": 0, "dy": 80, "after_ms": 600 },
    {
      "kind": "wait_for",
      "expect": { "present": [ { "label": "Export All Health Data" } ] },
      "timeout_ms": 4000,
      "poll_ms": 200
    },
    { "kind": "tap_label", "label": "Export All Health Data", "after_ms": 800 },
    {
      "kind": "wait_for",
      "expect": { "present": [ { "kind": "Button", "label": "Export" } ] },
      "timeout_ms": 5000,
      "poll_ms": 200
    },
    { "kind": "tap_locator", "locator": { "kind": "Button", "label": "Export" }, "after_ms": 1000 }
  ]
}
