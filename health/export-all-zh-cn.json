{
  "version": 1,
  "name": "导出全部健康数据（发起）",
  "description": "中文界面。启动「健康」，在「摘要」页打开右上角「资料」，滚动到底部，点「导出所有健康数据」，在系统确认框按「导出」（原生 alert 路径；该弹窗不一定出现在元素树里，所以不用 wait_for 等它）。手机随后打包 zip（约 1 分钟）并弹出共享面板；接着运行 health/save-export-to-files-zh-cn，或读取 /agent/elements 自行处理。任一标签缺失或重复时不会点击（fail-closed）。",
  "app": "com.apple.Health",
  "category": "health",
  "risk": "navigation",
  "locale": "zh-CN",
  "tags": [
    "export",
    "backup",
    "no-canary"
  ],
  "steps": [
    {
      "kind": "launch_app",
      "bundle": "com.apple.Health",
      "after_ms": 500
    },
    {
      "kind": "wait_for",
      "expect": {
        "application": "健康",
        "present": [
          {
            "identifier": "UIA.Health.Tab.Summary"
          }
        ]
      },
      "timeout_ms": 8000,
      "poll_ms": 250
    },
    {
      "kind": "tap_locator",
      "locator": {
        "identifier": "UIA.Health.Tab.Summary"
      },
      "after_ms": 500
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "kind": "Button",
            "label": "资料"
          }
        ]
      },
      "timeout_ms": 5000,
      "poll_ms": 200
    },
    {
      "kind": "tap_locator",
      "locator": {
        "kind": "Button",
        "label": "资料"
      },
      "after_ms": 800
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "identifier": "UIA.Health.ShowHealthDetails"
          }
        ]
      },
      "timeout_ms": 5000,
      "poll_ms": 200
    },
    {
      "kind": "scroll",
      "x": 0.5,
      "y": 0.6,
      "dx": 0,
      "dy": 80,
      "after_ms": 400
    },
    {
      "kind": "scroll",
      "x": 0.5,
      "y": 0.6,
      "dx": 0,
      "dy": 80,
      "after_ms": 400
    },
    {
      "kind": "scroll",
      "x": 0.5,
      "y": 0.6,
      "dx": 0,
      "dy": 80,
      "after_ms": 600
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "identifier": "UIA.Health.ExportAllHealthData"
          }
        ]
      },
      "timeout_ms": 4000,
      "poll_ms": 200
    },
    {
      "kind": "tap_locator",
      "locator": {
        "identifier": "UIA.Health.ExportAllHealthData"
      },
      "after_ms": 1000
    },
    {
      "kind": "pause",
      "ms": 1500
    },
    {
      "kind": "alert",
      "button": "导出",
      "after_ms": 1000
    }
  ],
  "verified_on": [
    {
      "device": "iPhone 17 Pro Max",
      "ios": "27.0",
      "app_version": "27.0",
      "date": "2026-09-05"
    }
  ]
}
