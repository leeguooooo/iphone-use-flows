{
  "version": 1,
  "name": "Open Health",
  "description": "Launch Apple Health and wait until the app is in the foreground.",
  "app": "com.apple.Health",
  "category": "health",
  "risk": "navigation",
  "steps": [
    {
      "kind": "launch_app",
      "bundle": "com.apple.Health",
      "after_ms": 300
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "kind": "Application"
          }
        ]
      },
      "timeout_ms": 6000,
      "poll_ms": 200
    }
  ],
  "verified_on": [
    {
      "device": "iPhone 17 Pro Max",
      "ios": "26",
      "date": "2026-09-05"
    }
  ]
}
