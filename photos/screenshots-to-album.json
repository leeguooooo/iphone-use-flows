{
  "version": 1,
  "name": "Put all screenshots into a new album",
  "description": "照片：搜索「截屏」，全选结果并添加到新建相簿。只新建相簿，不删除任何照片。",
  "app": "com.apple.mobileslideshow",
  "category": "media",
  "risk": "side_effect",
  "locale": "zh-CN",
  "inputs": {
    "album": {
      "type": "string",
      "description": "新相簿名称。不要含数字：中文拼音输入法会吞掉数字。"
    }
  },
  "steps": [
    {
      "kind": "launch_app",
      "bundle": "com.apple.mobileslideshow",
      "fresh": true
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "kind": "TabBar"
          }
        ]
      },
      "timeout_ms": 8000
    },
    {
      "kind": "tap_locator",
      "locator": {
        "kind": "Button",
        "label": "搜索"
      }
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "kind": "TextView",
            "focused": true
          }
        ]
      },
      "timeout_ms": 4000
    },
    {
      "kind": "pause",
      "ms": 700
    },
    {
      "kind": "type",
      "text": "截屏",
      "after_ms": 0
    },
    {
      "kind": "key",
      "name": "return"
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "kind": "Button",
            "label": "选择"
          }
        ]
      },
      "timeout_ms": 15000
    },
    {
      "kind": "pause",
      "ms": 1200
    },
    {
      "kind": "tap_label",
      "label": "选择"
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "kind": "Button",
            "label": "全选"
          }
        ]
      },
      "timeout_ms": 12000
    },
    {
      "kind": "tap_label",
      "label": "全选"
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "label": "取消全选"
          }
        ]
      },
      "timeout_ms": 4000
    },
    {
      "kind": "tap_label",
      "label": "更多"
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "kind": "Button",
            "label": "添加到"
          }
        ]
      },
      "timeout_ms": 4000
    },
    {
      "kind": "tap_locator",
      "locator": {
        "kind": "Button",
        "label": "添加到"
      }
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "kind": "Button",
            "label": "新建相簿"
          }
        ]
      },
      "timeout_ms": 4000
    },
    {
      "kind": "tap_locator",
      "locator": {
        "kind": "Button",
        "label": "新建相簿"
      }
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "kind": "TextField",
            "focused": true
          }
        ]
      },
      "timeout_ms": 4000
    },
    {
      "kind": "type",
      "input": "album"
    },
    {
      "kind": "tap_label",
      "label": "完成"
    },
    {
      "kind": "pause",
      "ms": 2000
    }
  ],
  "verified_on": [
    {
      "device": "iPhone 17 Pro Max",
      "ios": "27.0",
      "date": "2026-10-19",
      "app_version": "27.0"
    }
  ],
  "tags": [
    "no-canary"
  ],
  "example_inputs": {
    "album": "截屏汇总"
  }
}
